# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time.

# mock (default): in-browser mock services, no backend needed.
# api: the knot-server AWS SAM backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# `sam local start-api` (knot-server `npm run start`) listens on 3001.
# For AWS, use the ApiUrl output of `sam deploy`.
NEXT_PUBLIC_API_URL=http://localhost:3001
